cabal-version: 2.4
name: oke
version: 0.1.0.0
license: MIT
copyright: 2026 Meowcolm024
author: Meowcolm024
category: Package Management
homepage: https://github.com/meowcolm024/oke
extra-source-files:
  LICENSE
  README.md

common shared
  ghc-options:
    -Wall
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies
    -Wunused-foralls
    -Wunused-foralls
    -fprint-explicit-foralls
    -fprint-explicit-kinds
    -Werror

  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude, Relude.Container.One),
    relude,

  default-extensions:
    DataKinds
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    MultiWayIf
    NoStarIsType
    OverloadedRecordDot
    OverloadedStrings
    StrictData
    TypeFamilies
    ViewPatterns

  build-depends:
    aeson >=2.2 && <3,
    ansi-terminal >=1.1 && <2,
    base >=4.7 && <5,
    base16-bytestring >=1 && <2,
    cryptohash-sha256 >=0.11 && <0.12,
    directory >=1.3 && <2,
    effectful >=2.6 && <3,
    filelock >=0.1 && <0.2,
    formatting >=7.2 && <8,
    fuzzyset >=0.3 && <0.4,
    hslogger >=1.3 && <2,
    http-client >=0.7 && <0.8,
    http-client-tls >=0.3 && <0.5,
    http-types >=0.12 && <0.13,
    network-uri >=2.6 && <3,
    optparse-applicative >=0.18 && <0.19,
    path >=0.9 && <0.10,
    path-io >=1.8 && <2,
    process >=1.6 && <2,
    relude >=1.0,
    text >=2 && <3,
    time >=1 && <2,
    unix >=2.8 && <3,
    versions >=6.0 && <7,
    yaml >=0.11 && <0.12,

  default-language: GHC2021

library
  import: shared
  hs-source-dirs: src
  exposed-modules: Oke
  other-modules:
    Oke.App.CLI
    Oke.App.Config
    Oke.App.Env
    Oke.App.Run
    Oke.Core.Artifact
    Oke.Core.Cask
    Oke.Core.Query
    Oke.Core.Registry
    Oke.Core.State
    Oke.Core.Status
    Oke.Effect
    Oke.Effect.Console
    Oke.Effect.FileSystem
    Oke.Effect.Log
    Oke.Effect.Network
    Oke.Effect.Store
    Oke.Effect.Time
    Oke.Util.Plist

  other-modules: Paths_oke
  autogen-modules: Paths_oke
  pkgconfig-depends:
    libplist-2.0

executable oke
  import: shared
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: oke

test-suite oke-test
  import: shared
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    hspec >=2.11 && <3,
    oke,
