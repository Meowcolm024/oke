cabal-version: 2.4
name: oke
version: 0.1.0.0
license: MIT
copyright: 2026 Meowcolm024
author: Meowcolm024
category: Web
homepage: https://github.com/meowcolm024/oke
extra-source-files:
  LICENSE
  README.md

common shared
  ghc-options:
    -Wall
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies
    -Wunused-foralls
    -Wunused-foralls
    -fprint-explicit-foralls
    -fprint-explicit-kinds
    -Werror

  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude, Relude.Container.One),
    relude,

  default-extensions:
    DataKinds
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    MultiWayIf
    NoStarIsType
    OverloadedRecordDot
    OverloadedStrings
    StrictData
    TypeFamilies
    ViewPatterns

  build-depends:
    HaXml >=1.25 && <2,
    acid-state >=0.16 && <0.17,
    aeson >=2.2 && <3,
    ansi-terminal >=1.1 && <2,
    base >=4.7 && <5,
    directory >=1.3 && <2,
    effectful >=2.6 && <3,
    hslogger >=1.3 && <2,
    optparse-applicative >=0.18 && <0.19,
    path >=0.9 && <0.10,
    process >=1.6 && <2,
    relude >=1.0,
    req >=3.13 && <4,
    text >=2 && <3,
    unix >=2.8 && <3,
    yaml >=0.11 && <0.12,

  default-language: GHC2021

library
  import: shared
  hs-source-dirs: src
  exposed-modules: Oke
  other-modules:
    Oke.App.CLI
    Oke.App.Config
    Oke.App.Context
    Oke.App.Runner
    Oke.Effect
    Oke.Effect.Log

executable oke
  import: shared
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: oke

test-suite oke-test
  import: shared
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    hspec >=2.11 && <3,
    oke,
